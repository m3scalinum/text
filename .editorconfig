root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csproj,props,targets,slnx}]
indent_size = 4

[*.{json,yml,yamlm}]
indent_size = 2

[*.{md,typ}]
trim_trailing_whitespace = false

[*.rs]
indent_size = 4
max_line_length = 100

[*.{csproj,props,target}]
indent_size = 2

[*.{cs}]
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent

csharp_prefer_braces = when_multiline:silent
csharp_using_directive_placement = outside_namespace:warning

dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.i_prefixed.capitalization = pascal_case

dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1815.severity = none
