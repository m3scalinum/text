<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PackageId>M3scalinum.Text.Pdf.Tests</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Text.Pdf\Text.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Real documents, compiled by M3scalinum.Text.SharpTypst with Typst 0.15.1 and committed as
      bytes: the checker must survive a real producer, not a hand-written minimal file. See
      fixtures/pdfua/README.md for how each one was produced.
    -->
    <None Update="fixtures\pdfua\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\text\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
  </ItemGroup>

</Project>
