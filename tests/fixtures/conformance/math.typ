// Math — every item of the category, invoked once.
$ frac(a, b) $

$ sqrt(x) + root(x, 3) $

$ binom(n, k) $

$ vec(1, 2, 3) $

$ mat(1, 2; 3, 4) $

$ cases(x & "if" x > 0, -x & "otherwise") $

$ lr((a + b)) $

$ accent(x, hat) $

$ attach(x, t: 2, b: 3) $

$ op("lim", limits: #true)_x $

$ class("relation", =) $

$ cancel(x) $

$ primes(#2) $

$ stretch(arrow.r) $

$ display(sum_i x_i) + inline(sum_i x_i) + script(x) + sscript(x) $

$ upright(A) + italic(A) + bold(A) $

$ underbrace(1 + 2, 3) + overbrace(1 + 2, 3) $

$ serif(A) + sans(A) + frak(A) + mono(A) + bb(N) + cal(P) + scr(L) $

#math.equation(block: true, $ x^2 + y^2 = z^2 $)
