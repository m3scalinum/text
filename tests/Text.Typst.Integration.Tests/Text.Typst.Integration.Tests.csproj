<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PackageId>M3scalinum.Text.Typst.Integration.Tests</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Text.Typst\Text.Typst.csproj" />
    <ProjectReference Include="..\..\src\Text.Pdf.FactureX\Text.Pdf.FactureX.csproj" />
    <ProjectReference Include="..\..\src\Text.Typst.Native\Text.Typst.Native.csproj" />
    <ProjectReference Include="..\..\src\Text.Typst.DependencyInjection\Text.Typst.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Text.Templates.Generator\Text.Templates.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\templates\**\template.toml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\templates\**\*"
             Link="templates\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="templates\minimal\**\*"
                      LogicalName="M3scalinum.Text.Typst.Integration.Tests.templates.minimal.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
  </ItemGroup>

</Project>
