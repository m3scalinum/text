<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This package follows the suite, not the compiler: see Directory.Build.props.
      The release tag is the version, so a release passes -p:SuiteVersion=<tag>; nothing here derives
      the number from anything else. A local build has no tag, so it falls back to TextVersion.
    -->
    <SuiteVersion Condition="'$(SuiteVersion)' == ''">$(TextVersion)</SuiteVersion>
    <Version>$(SuiteVersion)</Version>
    <AssemblyVersion>$(SuiteVersion)</AssemblyVersion>
    <FileVersion>$(SuiteVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IsPackable>true</IsPackable>
    <PackageId>M3scalinum.Text.Templates</PackageId>
    <Description>Typed business-document layouts for M3scalinum.Text.Typst: invoice (facture), quotation (devis), account statement (relevé), attestation, contract (contrat), payslip (bulletin de paie) and purchase order (bon de commande), with English and French labels supplied as data.</Description>
    <PackageTags>typst;templates;invoice;facture;quotation;devis;statement;attestation;contract;contrat;payslip;bulletin-de-paie;purchase-order;bon-de-commande;pdf</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <TargetFramework />
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!--
      The abstractions ship inside the shared framework above net10, so the package reference below
      does not exist there; on net8, net9 and net10 it must match the runtime's own major, as the
      DependencyInjection package does.
    -->
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.2</ExtensionsVersion>
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.23</ExtensionsVersion>
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.15</ExtensionsVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Two ways to reach the compiler wrapper, because the two package families release on separate
      trains: a project reference inside the repository, and an exact package reference at release
      time, so the packed dependency names a core version that exists on NuGet.
    -->
    <ProjectReference Include="..\Text.Typst\Text.Typst.csproj" Condition="'$(CoreVersion)' == ''" />
    <PackageReference Include="M3scalinum.Text.Typst" Condition="'$(CoreVersion)' != ''" />

    <!-- The layouts are compiled into the assembly: a consumer needs no template directory. -->
    <EmbeddedResource Include="layouts\invoice\template.toml"
                      LogicalName="M3scalinum.Text.Templates.templates.invoice.template.toml" />
    <EmbeddedResource Include="layouts\invoice\template.typ"
                      LogicalName="M3scalinum.Text.Templates.templates.invoice.template.typ" />
    <EmbeddedResource Include="layouts\quotation\template.toml"
                      LogicalName="M3scalinum.Text.Templates.templates.quotation.template.toml" />
    <EmbeddedResource Include="layouts\quotation\template.typ"
                      LogicalName="M3scalinum.Text.Templates.templates.quotation.template.typ" />
    <EmbeddedResource Include="layouts\statement\template.toml"
                      LogicalName="M3scalinum.Text.Templates.templates.statement.template.toml" />
    <EmbeddedResource Include="layouts\statement\template.typ"
                      LogicalName="M3scalinum.Text.Templates.templates.statement.template.typ" />
    <EmbeddedResource Include="layouts\attestation\template.toml"
                      LogicalName="M3scalinum.Text.Templates.templates.attestation.template.toml" />
    <EmbeddedResource Include="layouts\attestation\template.typ"
                      LogicalName="M3scalinum.Text.Templates.templates.attestation.template.typ" />
    <EmbeddedResource Include="layouts\contract\template.toml"
                      LogicalName="M3scalinum.Text.Templates.templates.contract.template.toml" />
    <EmbeddedResource Include="layouts\contract\template.typ"
                      LogicalName="M3scalinum.Text.Templates.templates.contract.template.typ" />
    <EmbeddedResource Include="layouts\payslip\template.toml"
                      LogicalName="M3scalinum.Text.Templates.templates.payslip.template.toml" />
    <EmbeddedResource Include="layouts\payslip\template.typ"
                      LogicalName="M3scalinum.Text.Templates.templates.payslip.template.typ" />
    <EmbeddedResource Include="layouts\purchase-order\template.toml"
                      LogicalName="M3scalinum.Text.Templates.templates.purchase-order.template.toml" />
    <EmbeddedResource Include="layouts\purchase-order\template.typ"
                      LogicalName="M3scalinum.Text.Templates.templates.purchase-order.template.typ" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The options records are generated from these manifests, so a parameter renamed in a layout is
      a build error in the record that fills it. The analyzer package ships the same item
      automatically to consumers; a project reference does not run its build/ props.
    -->
    <AdditionalFiles Include="layouts\**\template.toml" />
    <ProjectReference Include="..\Text.Templates.Generator\Text.Templates.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="$(ExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="M3scalinum.Text.Templates.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

</Project>
