<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PublishAot>false</PublishAot>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>M3scalinum.Text.Templates.Generator</PackageId>
    <!-- An analyzer package has no lib/ and no dependencies; NU5017 would reject it otherwise. -->
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- No symbols package: the analyzer ships no lib/ output, so a .snupkg would be empty. -->
    <IncludeSymbols>false</IncludeSymbols>
    <Description>Source generator for M3scalinum.Text.Typst templates: turns a template.toml manifest into a typed options record.</Description>
    <PackageTags>typst;templates;source-generator;roslyn</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build\M3scalinum.Text.Templates.Generator.props"
          Pack="true" PackagePath="build" />
    <!-- An analyzer package has no lib/; the placeholder keeps NuGet from rejecting it (NU5017). -->
    <None Include="_._" Pack="true" PackagePath="lib/netstandard2.0/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

</Project>
