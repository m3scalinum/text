<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This package follows the suite, not the compiler: it depends on packages from both trains — the
      compiler wrapper and the document model on one side, the layout pack and the PDF package on the
      other — and a package that follows the Typst version cannot depend on one that does not. See
      Directory.Build.props.
    -->
    <SuiteVersion Condition="'$(SuiteVersion)' == ''">$(TextVersion)</SuiteVersion>
    <Version>$(SuiteVersion)</Version>
    <AssemblyVersion>$(SuiteVersion)</AssemblyVersion>
    <FileVersion>$(SuiteVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IsPackable>true</IsPackable>
    <PackageId>M3scalinum.Text.Mcp</PackageId>
    <Description>A Model Context Protocol server over stdio or HTTP for M3scalinum.Text: render Typst documents from a model or from the layout pack, sign, merge and read PDFs, and write nothing to disk unless the host says so.</Description>
    <PackageTags>mcp;model-context-protocol;json-rpc;stdio;http;streamable-http;typst;pdf;invoice;sign;pades;merge</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <TargetFramework />
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!--
      The protocol surface is hand-written JSON-RPC on top of a source-generated serializer context:
      a host must be publishable with PublishAot and trimmed, which a reflection-based serializer is
      not. IsAotCompatible turns on the trim and AOT analyzers so a regression fails the build here
      rather than in a consumer's publish.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Two ways to reach the compiler wrapper, because the two package families release on separate
      trains: a project reference inside the repository, and an exact package reference at release
      time, so the packed dependency names a core version that exists on NuGet.
    -->
    <ProjectReference Include="..\Text.Typst\Text.Typst.csproj" Condition="'$(CoreVersion)' == ''" />
    <PackageReference Include="M3scalinum.Text.Typst" Condition="'$(CoreVersion)' != ''" />

    <ProjectReference Include="..\Text.Templates\Text.Templates.csproj" />

    <!-- Signing, merging and reading a PDF are the operations of this package family, and it
         releases on the same suite train as this one, so a project reference is what names it. -->
    <ProjectReference Include="..\Text.Pdf\Text.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="M3scalinum.Text.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

</Project>
