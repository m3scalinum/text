<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This package follows the suite, not the compiler: see Directory.Build.props.
      The release tag is the version, so a release passes -p:SuiteVersion=<tag>; nothing here derives
      the number from anything else. A local build has no tag, so it falls back to TextVersion, which
      is bumped to the last released version to keep an untagged build from claiming an older one.
    -->
    <SuiteVersion Condition="'$(SuiteVersion)' == ''">$(TextVersion)</SuiteVersion>
    <Version>$(SuiteVersion)</Version>
    <AssemblyVersion>$(SuiteVersion)</AssemblyVersion>
    <FileVersion>$(SuiteVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IsPackable>true</IsPackable>
    <PackageId>M3scalinum.Text.Pdf.FactureX</PackageId>
    <Description>Factur-X / ZUGFeRD invoices for M3scalinum.Text.Typst: read a CII or UBL invoice, validate it against the EN 16931 rules, and render a PDF/A-3 with the XML attached and the Factur-X XMP metadata.</Description>
    <PackageTags>typst;pdf;facturx;zugferd;e-invoicing;en16931;invoice;pdfa</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <TargetFramework />
    <!-- Same build-time SourceLink warning as M3scalinum.Text.Typst; see that project. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Two ways to reach the compiler wrapper, because the two package families release on separate
      trains. In the repository it is a project reference, so a change to the wrapper flows into
      this package immediately. In the Pdf release it is a package reference to an already
      published version: a release of this package must name a core version that exists on NuGet,
      not one from a build that never left the machine. Set by the workflow through CoreVersion.
    -->
    <ProjectReference Include="..\Text.Typst\Text.Typst.csproj" Condition="'$(CoreVersion)' == ''" />
    <PackageReference Include="M3scalinum.Text.Typst" Condition="'$(CoreVersion)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="M3scalinum.Text.Pdf.FactureX.Tests" />
    <InternalsVisibleTo Include="M3scalinum.Text.Typst.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

</Project>
