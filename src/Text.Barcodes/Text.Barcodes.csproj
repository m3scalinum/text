<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This package follows the suite, not a compiler: see Directory.Build.props. The release tag is
      the version, so a release passes -p:SuiteVersion=<tag>; a local build falls back to
      TextVersion, which is bumped to the last released version.
    -->
    <SuiteVersion Condition="'$(SuiteVersion)' == ''">$(TextVersion)</SuiteVersion>
    <Version>$(SuiteVersion)</Version>
    <AssemblyVersion>$(SuiteVersion)</AssemblyVersion>
    <FileVersion>$(SuiteVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <!-- Clears the single-TFM default Directory.Build.props sets, as the other multi-targeted
         projects do; without it only net11.0 is built and pack fails on the missing assemblies. -->
    <TargetFramework />
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>M3scalinum.Text.Barcodes</PackageId>
    <Description>Encode and decode 19 barcode symbologies in-process — QR Code, Micro QR, DataMatrix, Aztec, PDF417, MaxiCode, Code 128, 39 and 93, Telepen, EAN-13 and EAN-8, UPC-A and UPC-E, ITF, Codabar, GS1-128 and GS1 DataBar — to SVG or PNG, decode every symbol on a page, and build GS1 element strings and Digital Link URLs.</Description>
    <PackageTags>barcode;qrcode;micro-qr;datamatrix;aztec;pdf417;maxicode;ean13;ean8;upc;code128;code39;code93;telepen;itf;codabar;gs1;databar;svg;png</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The live-handle counter is the diagnostic the leak test asserts on. -->
    <InternalsVisibleTo Include="M3scalinum.Text.Barcodes.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A document entry point takes a TypstDocument, so this package sits above the document model.
      The direction is the right one: the model knows nothing about barcodes, and the barcode
      package only emits the figure the model already understands — no dependency is added to
      M3scalinum.Text.Documents, and none is added here in the other direction.
    -->
    <ProjectReference Include="..\Text.Documents\Text.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

  <!--
    Natives are packed under the standard runtimes/<rid>/native/ layout, so no buildTransitive
    targets are needed. The files are produced by the CI matrix; a local pack simply omits the ones
    that are not there, and the resolver then reports the RID it could not load.
  -->
  <ItemGroup>
    <None Include="$(NativeArtifactsDir)\win-x64\sharp_text_barcodes.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\win-x64\sharp_text_barcodes.dll')" />
    <None Include="$(NativeArtifactsDir)\win-arm64\sharp_text_barcodes.dll"
          Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\win-arm64\sharp_text_barcodes.dll')" />
    <None Include="$(NativeArtifactsDir)\linux-x64\libsharp_text_barcodes.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-x64\libsharp_text_barcodes.so')" />
    <None Include="$(NativeArtifactsDir)\linux-arm64\libsharp_text_barcodes.so"
          Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-arm64\libsharp_text_barcodes.so')" />
    <!-- A musl target cannot be a cdylib: the CI links the staticlib with `musl-gcc`, the compiler's
         recipe, so Alpine gets a library it can load instead of DllNotFoundException — on x64 and,
         on the arm64 runner whose `musl-tools` links for that architecture, on arm64 too. -->
    <None Include="$(NativeArtifactsDir)\linux-musl-x64\libsharp_text_barcodes.so"
          Pack="true" PackagePath="runtimes/linux-musl-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-musl-x64\libsharp_text_barcodes.so')" />
    <None Include="$(NativeArtifactsDir)\linux-musl-arm64\libsharp_text_barcodes.so"
          Pack="true" PackagePath="runtimes/linux-musl-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-musl-arm64\libsharp_text_barcodes.so')" />
    <!-- One thin dylib per architecture: a universal binary would copy an x86_64 slice into every
         Apple-silicon consumer's output, and an arm64 slice into every Intel one. -->
    <None Include="$(NativeArtifactsDir)\osx-arm64\libsharp_text_barcodes.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\osx-arm64\libsharp_text_barcodes.dylib')" />
    <None Include="$(NativeArtifactsDir)\osx-x64\libsharp_text_barcodes.dylib"
          Pack="true" PackagePath="runtimes/osx-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\osx-x64\libsharp_text_barcodes.dylib')" />
  </ItemGroup>

</Project>
