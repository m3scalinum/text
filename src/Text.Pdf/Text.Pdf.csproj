<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This package follows the suite, not the compiler: see Directory.Build.props.
      The release tag is the version, so a release passes -p:SuiteVersion=<tag>; nothing here derives
      the number from anything else. A local build has no tag, so it falls back to TextVersion, which
      is bumped to the last released version to keep an untagged build from claiming an older one.
    -->
    <SuiteVersion Condition="'$(SuiteVersion)' == ''">$(TextVersion)</SuiteVersion>
    <Version>$(SuiteVersion)</Version>
    <AssemblyVersion>$(SuiteVersion)</AssemblyVersion>
    <FileVersion>$(SuiteVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <!-- Clears the single-TFM default Directory.Build.props sets, as the other multi-targeted
         projects do; without it only net11.0 is built and pack fails on the missing assemblies. -->
    <TargetFramework />
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>M3scalinum.Text.Pdf</PackageId>
    <Description>Sign a PDF with PAdES, read its text and outline, and render a page as a PNG preview; post-process the documents M3scalinum.Text.Typst produces.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PkcsVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.2</PkcsVersion>
    <PkcsVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.23</PkcsVersion>
    <PkcsVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.15</PkcsVersion>
    <PkcsVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</PkcsVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The conformance tests drive the reader directly: the lexer, the cross-reference sections
         and the value types have no public entry point, and testing them through a report would
         assert symptoms instead of the parse. -->
    <InternalsVisibleTo Include="M3scalinum.Text.Pdf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sized to the runtime, like the Microsoft.Extensions.* packages of the DI package. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" VersionOverride="$(PkcsVersion)" />
    <PackageReference Include="System.IO.Hashing" VersionOverride="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

  <!--
    The page rasteriser is a Rust cdylib of its own, `native/text-pdf`, packed under the standard
    runtimes/<rid>/native/ layout. The rest of this package is managed code; the six files are
    produced by the native matrix of ci-text.yml, and a checkout without them still builds, because a
    managed build never depends on a Rust toolchain. `linux-musl-x64` is a staticlib linked by hand
    with `musl-gcc`, exactly as the compiler's is: Rust cannot emit a cdylib for a musl target.
  -->
  <ItemGroup>
    <None Include="$(NativeArtifactsDir)\win-x64\sharp_text_pdf.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\win-x64\sharp_text_pdf.dll')" />
    <None Include="$(NativeArtifactsDir)\win-arm64\sharp_text_pdf.dll"
          Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\win-arm64\sharp_text_pdf.dll')" />
    <None Include="$(NativeArtifactsDir)\linux-x64\libsharp_text_pdf.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-x64\libsharp_text_pdf.so')" />
    <None Include="$(NativeArtifactsDir)\linux-arm64\libsharp_text_pdf.so"
          Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-arm64\libsharp_text_pdf.so')" />
    <None Include="$(NativeArtifactsDir)\linux-musl-x64\libsharp_text_pdf.so"
          Pack="true" PackagePath="runtimes/linux-musl-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-musl-x64\libsharp_text_pdf.so')" />
    <None Include="$(NativeArtifactsDir)\osx\libsharp_text_pdf.dylib"
          Pack="true" PackagePath="runtimes/osx/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\osx\libsharp_text_pdf.dylib')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="M3scalinum.Text.Pdf.Tests" />
  </ItemGroup>

</Project>
