<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The OCR package follows the suite, not the compiler: see Directory.Build.props.
      A release passes -p:SuiteVersion=<tag>; an untagged build falls back to TextVersion.
    -->
    <SuiteVersion Condition="'$(SuiteVersion)' == ''">$(TextVersion)</SuiteVersion>
    <Version>$(SuiteVersion)</Version>
    <AssemblyVersion>$(SuiteVersion)</AssemblyVersion>
    <FileVersion>$(SuiteVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <!-- Clears the single-TFM default Directory.Build.props sets. -->
    <TargetFramework />
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>M3scalinum.Text.Ocr</PackageId>
    <Description>Read text from page images and scanned PDFs in-process, with models the caller supplies: words, lines and boxes, confidence thresholds that refuse a page instead of guessing, quarter-turn detection, deskew and denoise, and the model fingerprints behind every result.</Description>
    <PackageTags>ocr;text-recognition;scanned-pdf;image;preprocessing;deskew;rten</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="M3scalinum.Text.Ocr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

  <!--
    Natives are packed under the standard runtimes/<rid>/native/ layout, so no buildTransitive
    targets are needed. The files come from the native matrix; a local pack simply omits the ones
    that are not there, and the resolver then names the RID it could not load.
    Both musl RIDs are staticlibs linked by hand with `musl-gcc`, exactly as the compiler's is:
    Rust cannot emit a cdylib for a musl target, so the CI job builds the archive and links it.
  -->
  <ItemGroup>
    <None Include="$(NativeArtifactsDir)\win-x64\sharp_text_ocr.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\win-x64\sharp_text_ocr.dll')" />
    <None Include="$(NativeArtifactsDir)\win-arm64\sharp_text_ocr.dll"
          Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\win-arm64\sharp_text_ocr.dll')" />
    <None Include="$(NativeArtifactsDir)\linux-x64\libsharp_text_ocr.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-x64\libsharp_text_ocr.so')" />
    <None Include="$(NativeArtifactsDir)\linux-arm64\libsharp_text_ocr.so"
          Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-arm64\libsharp_text_ocr.so')" />
    <None Include="$(NativeArtifactsDir)\linux-musl-x64\libsharp_text_ocr.so"
          Pack="true" PackagePath="runtimes/linux-musl-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-musl-x64\libsharp_text_ocr.so')" />
    <None Include="$(NativeArtifactsDir)\linux-musl-arm64\libsharp_text_ocr.so"
          Pack="true" PackagePath="runtimes/linux-musl-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\linux-musl-arm64\libsharp_text_ocr.so')" />
    <!-- One thin dylib per architecture: a universal binary would copy an x86_64 slice into every
         Apple-silicon consumer's output, and an arm64 slice into every Intel one. -->
    <None Include="$(NativeArtifactsDir)\osx-arm64\libsharp_text_ocr.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\osx-arm64\libsharp_text_ocr.dylib')" />
    <None Include="$(NativeArtifactsDir)\osx-x64\libsharp_text_ocr.dylib"
          Pack="true" PackagePath="runtimes/osx-x64/native/" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)\osx-x64\libsharp_text_ocr.dylib')" />
  </ItemGroup>

</Project>
