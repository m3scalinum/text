<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>M3scalinum.Text.Typst</PackageId>
    <Description>Hosts the Typst typesetting compiler in-process: compile Typst source to PDF, SVG, PNG, HTML, Markdown and plain text from .NET.</Description>
    <PackageTags>typst;pdf;typesetting;documents;report</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <TargetFramework />
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Text.Documents\Text.Documents.csproj" />
    <ProjectReference Include="..\Text.Typst.Native\Text.Typst.Native.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeNativeAssembly</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeNativeAssembly" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)M3scalinum.Text.Typst.Native.dll" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="M3scalinum.Text.Typst.Tests" />
    <InternalsVisibleTo Include="M3scalinum.Text.Typst.Integration.Tests" />
    <InternalsVisibleTo Include="M3scalinum.Text.Templates.Generator" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

  <!--
    No native library is packed here. NuGet fetches a package whole and picks assets by RID only
    after the download, so a package carrying seven libraries charges every consumer for six they
    cannot load (Spec 08 §6). The libraries ship in the per-RID satellites this package's consumer
    adds next to it — `M3scalinum.Text.Typst.Native.WinX64` and its six siblings, packed by
    `src/Text.Typst.Native.Package`.

    Nothing replaces this item group at pack time: a satellite whose native is missing is caught by
    `tests/verify-package.py`, and a consumer who installs no satellite is caught at load by
    `NativeLibraryResolver`, which names the package they are missing.
  -->

</Project>
