<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This package follows the suite, not the compiler: see Directory.Build.props.
      The release tag is the version, so a release passes -p:SuiteVersion=<tag>; nothing here derives
      the number from anything else.
    -->
    <SuiteVersion Condition="'$(SuiteVersion)' == ''">$(TextVersion)</SuiteVersion>
    <Version>$(SuiteVersion)</Version>
    <AssemblyVersion>$(SuiteVersion)</AssemblyVersion>
    <FileVersion>$(SuiteVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IsPackable>true</IsPackable>
    <PackageId>M3scalinum.Text.Epub</PackageId>
    <Description>Package a document as an EPUB 3 book: a valid container built with System.IO.Compression, no dependency and no native code.</Description>
    <PackageTags>epub;epub3;ebook;xhtml;opf;package</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <TargetFramework />
    <ImplicitUsings>disable</ImplicitUsings>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests drive the parser and the path checks directly: an invalid href has to be refused
         for its reason, not only through the exception the writer surfaces. -->
    <InternalsVisibleTo Include="M3scalinum.Text.Epub.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
