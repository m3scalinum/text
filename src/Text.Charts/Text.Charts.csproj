<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This package follows the suite, not the compiler: see Directory.Build.props. The release tag is
      the version, so a release passes -p:SuiteVersion=<tag>; nothing here derives the number from
      anything else.
    -->
    <SuiteVersion Condition="'$(SuiteVersion)' == ''">$(TextVersion)</SuiteVersion>
    <Version>$(SuiteVersion)</Version>
    <AssemblyVersion>$(SuiteVersion)</AssemblyVersion>
    <FileVersion>$(SuiteVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <!-- Clears the single-TFM default Directory.Build.props sets, as the other multi-targeted
         projects do; without it only net11.0 is built and pack fails on the missing assemblies. -->
    <TargetFramework />
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>M3scalinum.Text.Charts</PackageId>
    <Description>Declare a chart as a typed model and render it as standalone SVG a report can embed: line, area, grouped and stacked bars, scatter, pie, donut and sparkline. No dependency, no native code, no font.</Description>
    <PackageTags>charts;svg;charts-as-code;reports;typst;documents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="M3scalinum.Text.Charts.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

</Project>
